# Server only. Never prefix with NEXT_PUBLIC_ and never commit real values.
ANAM_API_KEY=
ANAM_PERSONA_ID=
# Optional: the Anam persona of the Jeroen sales avatar (the "Test sales avatar" button).
ANAM_PERSONA_ID_JEROEN=
# The one-time outbound call ("Test outbound sales agent"). Needs all three, plus the Upstash Redis store from
# the Vercel Marketplace (it adds KV_REST_API_URL and KV_REST_API_TOKEN by itself).
ELEVENLABS_API_KEY=
ELEVENLABS_CALL_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Optional: when set, visitors must enter this code before a session starts.
PITCH_INVITE_CODE=
# Optional overrides
PITCH_MAX_SESSIONS_PER_IP=3
PITCH_MAX_SESSIONS_PER_DAY=100
